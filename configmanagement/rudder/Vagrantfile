# -*- mode: ruby -*-
# vi: set ft=ruby :

require 'yaml'

config_path = File.join(File.dirname(__FILE__), 'vagrant.yaml')
settings = YAML.load_file(config_path)

Vagrant.configure('2') do |conf|
  (settings['machines'] || []).each do |vm|
    conf.vm.define vm['name'] do |node|
      node.vm.box = vm['box']
      node.vm.hostname = vm['name']

      node.vm.network "private_network", ip: vm['ip']
      node.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1", auto_correct: true if vm['role'] == "server"

      node.vm.provider 'virtualbox' do |vb|
        vb.memory = vm['memory'] if vm['memory']
        vb.cpus = vm['cpus'] if vm['cpus']
        vb.linked_clone = vm[:linked_clone]
      end

      node.vm.provision "shell" do |s|
        s.path = "scripts/bootstrap.sh"
        s.args = [vm["role"], vm["name"]]
        s.privileged = true
      end
    end
  end
end
